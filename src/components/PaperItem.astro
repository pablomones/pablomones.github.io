---
import type { Paper } from '../lib/content';
import { formatMonth, richText, withBase } from '../lib/format';
import { buttonLabel } from '../lib/buttons';
import Authors from './Authors.astro';

interface Props {
  paper: Paper;
}

const { paper } = Astro.props;
const { data } = paper;
const id = paper.id;
const abstractId = `${id}-abstract`;

type Action = { label: string; href: string; kind: 'external' | 'download' };
const actions: Action[] = [];
if (data.arxiv) {
  actions.push({ label: 'arXiv', href: `https://arxiv.org/abs/${data.arxiv}`, kind: 'external' });
  actions.push({ label: 'PDF', href: `https://arxiv.org/pdf/${data.arxiv}`, kind: 'download' });
}
// Cada botón lleva un link o un PDF (el esquema no deja los dos).
for (const b of data.attachments) {
  const label = buttonLabel(b.label, b.url, b.file);
  if (b.file) actions.push({ label, href: withBase(b.file), kind: 'download' });
  else if (b.url) actions.push({ label, href: withBase(b.url), kind: 'external' });
}
---

<article class="list-item paper" id={id}>
  <h3 class="paper-title">{data.title}</h3>
  <p class="meta"><Authors coauthors={data.coauthors} /> · {formatMonth(data.date)}</p>
  {data.journal && <p class="meta paper-journal">{data.journal}</p>}
  {data.status && <p class="paper-status">{data.status}</p>}
  <p class="actions">
    <button type="button" class="text-button abstract-toggle" aria-expanded="false" aria-controls={abstractId}>
      Abstract<span aria-hidden="true" class="sign">&nbsp;+</span>
    </button>
    {
      actions.map((a) => (
        <a href={a.href} rel={a.kind === 'external' ? 'noopener' : undefined}>
          {a.label}
          <span aria-hidden="true">&nbsp;{a.kind === 'download' ? '↓' : '↗'}</span>
        </a>
      ))
    }
  </p>
  <div class="abstract" id={abstractId}>
    <p set:html={richText(data.abstract)} />
  </div>
</article>

<style>
  .paper-title {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.4;
    text-wrap: balance;
  }

  .paper-journal {
    font-style: italic;
  }

  .paper-status {
    margin: 4px 0 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
  }

  .abstract p {
    margin: 6px 0 0;
    max-width: 640px;
    font-size: 15px;
    color: var(--body-2);
    text-wrap: pretty;
  }

  .paper:target .paper-title {
    color: var(--accent);
  }
</style>
