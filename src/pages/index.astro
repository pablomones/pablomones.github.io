---
import { Image } from 'astro:assets';
import Authors from '../components/Authors.astro';
import Base from '../layouts/Base.astro';
import { getResearchGroups, getSelectedPapers, getSite } from '../lib/content';
import { formatMonth, paragraphs, withBase } from '../lib/format';
import { findImage } from '../lib/photo';

const site = await getSite();
const bio = paragraphs(site.bio);
const selected = (await getResearchGroups()).length > 0 ? await getSelectedPapers() : [];


const photo = findImage(site.photo);
const links = [...(site.cv ? [{ label: 'CV (PDF)', url: withBase(site.cv) }] : []), ...site.links];
---

<Base current="about">
  <section class="intro">
    <div class="intro-text">
      <p class="label intro-position">{site.position} · {site.university}</p>
      <h1 class="intro-name">{site.name}</h1>
      <div class="bio">
        {bio.map((p) => <p set:html={p} />)}
      </div>
      {
        links.length > 0 && (
          <div class="profile">
            <ul class="profile-links">
              {links.map((l) => (
                <li>
                  <a
                    href={l.url}
                    rel={l.url.startsWith('http') ? 'me noopener' : undefined}
                    data-email={l.url.startsWith('mailto:') ? l.url.slice(7).split('?')[0] : undefined}
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
            <p class="copy-status" role="status" aria-live="polite" />
          </div>
        )
      }
    </div>
    {
      photo ? (
        <Image
          class="photo"
          src={photo}
          alt={`Portrait of ${site.name}`}
          widths={[320, 480, 640]}
          sizes="(max-width: 640px) 100vw, 320px"
          loading="eager"
          fetchpriority="high"
        />
      ) : (
        <div class="photo photo-placeholder" aria-hidden="true">
          [Photo, 4:5]
        </div>
      )
    }
  </section>

  {
    selected.length > 0 && (
      <section class="block" aria-labelledby="selected-heading">
        <h2 class="label" id="selected-heading">
          Selected research
        </h2>
        <ul class="block-body selected">
          {selected.map((p) => (
            <li>
              <a href={withBase(`/research/#${p.id}`)}>
                <span class="selected-title">{p.data.title}</span>
                <span class="meta">
                  <Authors coauthors={p.data.coauthors.map((c) => ({ name: c.name, url: undefined }))} /> ·{' '}
                  {formatMonth(p.data.date)}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<script>
  // El link "Email" abre el programa de correo si hay uno configurado. Como muchos no lo tienen
  // (por ejemplo, quien usa Gmail en el navegador), además copia la dirección y lo avisa.
  const status = document.querySelector<HTMLElement>('.copy-status');
  let hideTimer: number | undefined;

  function show(text: string) {
    if (!status) return;
    status.textContent = text;
    status.classList.add('is-visible');
    window.clearTimeout(hideTimer);
    hideTimer = window.setTimeout(() => status.classList.remove('is-visible'), 4000);
  }

  document.querySelectorAll<HTMLAnchorElement>('a[data-email]').forEach((link) => {
    link.addEventListener('click', () => {
      const email = link.dataset.email ?? '';
      navigator.clipboard?.writeText(email).then(
        () => show(`${email} · copied`),
        () => show(email),
      ) ?? show(email);
    });
  });
</script>

<style>
  .intro {
    padding-top: 56px;
    display: flex;
    flex-wrap: wrap;
    gap: 40px 64px;
    align-items: flex-start;
  }

  .intro-text {
    flex: 999 1 520px;
    min-width: 0;
  }

  .intro-position {
    color: var(--muted);
  }

  .intro-name {
    margin: 12px 0 0;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(48px, 6vw, 68px);
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .bio {
    margin-top: 28px;
    max-width: 620px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 17px;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .bio p {
    margin: 0;
  }

  .bio :global(a) {
    text-underline-offset: 3px;
  }

  .profile-links {
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    font-size: 15px;
    font-weight: 600;
  }

  .profile-links li {
    display: inline-flex;
    align-items: center;
  }

  .profile-links li + li::before {
    content: '|';
    margin: 0 12px;
    color: var(--sep);
    font-weight: 400;
  }

  .profile-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .profile {
    position: relative;
  }

  /* Aviso de "copiado": debajo de los links, sin mover el resto de la página. */
  .copy-status {
    position: absolute;
    top: 100%;
    left: 0;
    margin: 0;
    font-size: 13px;
    color: var(--muted);
    opacity: 0;
    transition: opacity 0.2s;
  }

  .copy-status.is-visible {
    opacity: 1;
  }

  .photo {
    flex: 1 1 240px;
    width: 100%;
    max-width: 320px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .photo-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--placeholder);
    font-size: 13px;
    color: var(--muted);
  }

  .intro + .block {
    margin-top: 56px;
  }

  .selected {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .selected a {
    display: block;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }

  .selected li:first-child a {
    padding-top: 0;
  }

  .selected-title {
    display: block;
    font-family: var(--serif);
    font-size: 24px;
    line-height: 1.25;
    text-wrap: balance;
  }

  .selected a:hover .selected-title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .selected .meta {
    display: block;
  }
</style>
