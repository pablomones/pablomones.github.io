---
// Los CSS índice traen unicode-range: el navegador baja solo los subconjuntos que la página usa.
import '@fontsource/instrument-serif/400.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '../styles/global.css';
import { getNav, getSite } from '../lib/content';
import { formatDate, withBase } from '../lib/format';
import { photo } from '../lib/photo';
import { getImage } from 'astro:assets';

interface Props {
  /** Título de la página; en el inicio va solo el nombre. */
  title?: string;
  description?: string;
  /** Qué ítem del menú queda marcado. */
  current: string;
}

const { title, description, current } = Astro.props;
const site = await getSite();
const nav = await getNav();

const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.position}, ${site.university}`;
const metaDescription = description ?? site.description ?? `${site.name}, ${site.position} at ${site.university}.`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const built = new Date();
// La foto también es la imagen que muestran WhatsApp, LinkedIn y otros al compartir el link.
const ogImage = photo ? await getImage({ src: photo, width: 800, format: 'jpg' }) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    {
      ogImage && (
        <>
          <meta property="og:image" content={new URL(ogImage.src, Astro.site)} />
          <meta property="og:image:width" content={String(ogImage.attributes.width)} />
          <meta property="og:image:height" content={String(ogImage.attributes.height)} />
          <meta property="og:image:alt" content={`Portrait of ${site.name}`} />
        </>
      )
    }
    <meta name="twitter:card" content="summary" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="site-name" href={withBase('/')}>{site.name}</a>
        <nav class="site-nav" aria-label="Main">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={withBase(item.href)} aria-current={item.key === current ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>
    <main id="content" class="wrap" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>© {built.getUTCFullYear()} {site.name}</span>
        <span>Last updated {formatDate(built)}</span>
      </div>
    </footer>
  </body>
</html>
